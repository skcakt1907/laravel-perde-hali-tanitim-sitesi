# ============================================================
# MC GORDIJNEN — CANLI (PRODUCTION) .env ŞABLONU
#
# Kullanım: bu dosyayı sunucuda `.env` olarak kopyala ve <> içindeki
# yerleri doldur. APP_KEY hazır geliyor (paylaşımlı hostingde komut satırı
# olmayabilir diye). Komut satırı varsa kendi anahtarını üretmen daha iyi:
#     php artisan key:generate
# APP_KEY oturum ve şifreli çerezleri imzalar — sonradan değiştirilirse
# açık oturumlar düşer, "sifremi unuttum" bağlantıları geçersiz olur.
#
# KRİTİK: APP_DEBUG=false olmalı. true kalırsa bir hata olduğunda
# ziyaretçi kod yollarını, SQL sorgularını ve .env değerlerini görür.
# ============================================================

APP_NAME="MC Gordijnen"
APP_ENV=production
APP_KEY=base64:BURAYA_KENDI_ANAHTARINIZI_URETIN
APP_DEBUG=false

# Sondaki eğik çizgi OLMADAN, https ile
APP_URL=https://<alanadi.nl>

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Canlıda gereksiz ayrıntı loglamayalım
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<veritabani_adi>
DB_USERNAME=<veritabani_kullanicisi>
DB_PASSWORD=<guclu_sifre>

# ─── Oturum güvenliği ───
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Oturum verisi şifreli saklanır
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Çerez yalnızca HTTPS üzerinden gönderilir — SSL kurulduktan SONRA true yap
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── E-POSTA ───
# log = hiçbir mail gitmez (sadece dosyaya yazılır). Canlıda MUTLAKA smtp yap,
# yoksa ölçü talepleri işletmeye ulaşmaz ve müşteriye onay maili gitmez.
MAIL_MAILER=smtp
MAIL_HOST=<smtp.sunucu.nl>
MAIL_PORT=587
MAIL_USERNAME=<posta_kullanicisi>
MAIL_PASSWORD=<posta_sifresi>
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="info@<alanadi.nl>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

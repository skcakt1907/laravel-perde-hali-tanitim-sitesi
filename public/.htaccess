# ============================================================
# public/.htaccess — web kökü
# Laravel'in standart kuralları + güvenlik ve önbellek sertleştirmesi.
#
# NOT: Güvenlik başlıkları ASIL olarak App\Http\Middleware\SecurityHeaders
# içinde üretilir (sunucu değişse bile korunsun diye). Buradakiler statik
# dosyalar (font, css, görsel) için yedektir — onlar PHP'den geçmez.
# ============================================================

# Dizin listelemeyi ve içerik uzlaşmasını kapat
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ─── HTTPS zorlaması ───
    # Canlıda SSL kurulduktan SONRA aşağıdaki üç satırı aktifleştir.
    # (Yerelde veya SSL yoksa açarsan site açılmaz — o yüzden kapalı geliyor.)
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Authorization başlığını taşı
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # X-XSRF-Token başlığını taşı
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Klasör değilse sondaki eğik çizgiyi at
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # İstekleri ön denetleyiciye gönder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ─── Gizli dosyalar (.env kopyası, .DS_Store …) — .well-known hariç ───
<FilesMatch "^\.(?!well-known)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ─── Buraya yanlışlıkla düşmüş hassas dosyalar ───
<FilesMatch "(?i)\.(env|log|sql|sqlite|sqlite3|db|bak|ini|yml|yaml|lock|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    # PHP sürümünü sızdırma (asıl kaldırma SecurityHeaders middleware'inde
    # header_remove ile yapılır; bu yedek). NOT: `Server` başlığı .htaccess'ten
    # kaldırılamaz — Apache yapılandırmasında `ServerTokens Prod` gerekir.

    # Statik dosyalar PHP'den geçmediği için başlıkları burada da veriyoruz
    <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|jpe?g|png|gif|webp|avif|ico)$">
        Header set X-Content-Type-Options "nosniff"
        Header set Referrer-Policy "strict-origin-when-cross-origin"
    </FilesMatch>
</IfModule>

# ─── Önbellek: sürümlenmiş/değişmeyen varlıklar uzun süre ───
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"

    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType text/javascript         "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 6 months"
    ExpiresByType image/png               "access plus 6 months"
    ExpiresByType image/webp              "access plus 6 months"
    ExpiresByType image/svg+xml           "access plus 6 months"
    ExpiresByType image/x-icon            "access plus 1 year"

    # HTML önbelleğe alınmasın — içerik panelden anında değişiyor
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# ─── Sıkıştırma ───
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        text/javascript application/javascript application/json \
        application/xml image/svg+xml
    # woff2 zaten sıkıştırılmış — tekrar sıkıştırmak boşa CPU
</IfModule>

# ─── Doğru MIME tipleri (eski sunucularda woff2 bilinmiyor olabilir) ───
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
    AddType image/avif .avif
</IfModule>

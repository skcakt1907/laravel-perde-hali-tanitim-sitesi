# ============================================================
# public/uploads — kullanıcı yüklemeleri
# Buraya sadece görsel gelir; ÇALIŞTIRILABİLİR hiçbir şey çalışmamalı.
# (Yükleme kodu uzantıyı istemciden değil dosya içeriğinden türetir ve
#  mime beyaz listesi uygular; bu dosya ikinci savunma hattıdır.)
# ============================================================

Options -Indexes -ExecCGI -MultiViews

# PHP'yi tamamen kapat (farklı modül adlarının hepsi için)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# LiteSpeed / bazı paylaşımlı hostinglerde PHP handler'ı sıfırla
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>

# Çalıştırılabilir uzantıları doğrudan reddet
<FilesMatch "(?i)\.(php|php[0-9]?|phtml|pht|phar|cgi|pl|py|rb|sh|exe|bat|com|jsp|asp|aspx|htaccess|htm|html|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Yüklenen dosyalar tarayıcıda çalıştırılmasın, indirilsin/gösterilsin
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; script-src 'none'"
</IfModule>

# Yüklenen dosyalarda betik çalıştırmayı engelle (güvenlik sertleştirmesi)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Çalıştırılabilir uzantıları reddet
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pht|phar|cgi|pl|py|asp|aspx|sh|exe)$">
    Require all denied
</FilesMatch>

Options -ExecCGI
